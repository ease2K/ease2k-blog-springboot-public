[Unit]
Description=ease2k Spring Boot Blog
After=network.target

[Service]
Type=exec
User=easeblog-spring
Group=easeblog-spring
WorkingDirectory=/opt/ease2k-blog-springboot/current
EnvironmentFile=/etc/ease2k-blog-springboot.env
ExecStart=/opt/jdk-27/bin/java --enable-native-access=ALL-UNNAMED -jar /opt/ease2k-blog-springboot/current/blog.jar
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/var/lib/ease2k-blog-springboot/editor
UMask=0027

[Install]
WantedBy=multi-user.target
