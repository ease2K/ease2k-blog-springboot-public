SPRING_PROFILES_ACTIVE=production
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8089
BLOG_PUBLIC_ORIGIN=https://blog.example.com
BLOG_CONTENT_DIRECTORY=/var/lib/ease2k-blog-springboot-postgresql/content
# 启用工作台时配置专用数据库、独立数据目录和 HTTPS 代理密钥
# BLOG_EDITOR_DIRECTORY=/var/lib/ease2k-blog-springboot-postgresql/editor
# BLOG_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/ease2k_blog
# BLOG_DATABASE_USERNAME=ease2k_blog
# BLOG_DATABASE_PASSWORD=
# BLOG_OWNER_PROXY_SECRET=由部署说明中的命令生成

# 使用备份服务时，配置同一数据库的 libpq 连接参数。
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=ease2k_blog
# PGUSER=ease2k_blog
# PGPASSFILE=/etc/ease2k-blog-postgresql.pgpass
